   "source": [
    "CREATE OR REPLACE TABLE TASTY_PIPELINE_QS_DB.ANALYTICS.DAILY_TRUCK_SALES AS\n",
    "SELECT\n",
    "    DATE(order_ts)   AS sales_date,\n",
    "    truck_id,\n",
    "    city,\n",
    "    COUNT(*)         AS orders,\n",
    "    SUM(order_total) AS revenue\n",
    "FROM TASTY_PIPELINE_QS_DB.STAGING.ORDERS_CLEAN\n",
    "GROUP BY ALL;"
   ]
  }
 ],
