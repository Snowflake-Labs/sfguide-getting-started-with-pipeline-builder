   "source": [
    "CREATE OR REPLACE TABLE TASTY_PIPELINE_QS_DB.STAGING.ORDERS_CLEAN AS\n",
    "SELECT DISTINCT order_id, truck_id, city, order_ts, order_total\n",
    "FROM TASTY_PIPELINE_QS_DB.RAW.ORDERS\n",
    "WHERE order_ts IS NOT NULL\n",
    "  AND order_total > 0;"
   ]
  }
